MANIFOLD_ADDR=:8080
MANIFOLD_DB_PATH=/var/lib/manifold/manifold.db
# The derived index (graph, document chunks, vectors). Deleting it is safe:
# Manifold seeds a new one from manifold.db at the next start.
MANIFOLD_INDEX_DB_PATH=/var/lib/manifold/index.db
MANIFOLD_BOOTSTRAP_API_KEY=replace-with-a-long-random-secret
MANIFOLD_PUBLIC_URL=http://localhost:8080
MANIFOLD_LOG_LEVEL=info
MANIFOLD_MAX_BODY_BYTES=5242880
# One model provider call (chat completion or embedding batch) may take this
# long; one document's whole extraction may take MANIFOLD_EXTRACTION_TIMEOUT.
MANIFOLD_PROVIDER_TIMEOUT=3m
MANIFOLD_EXTRACTION_TIMEOUT=30m
# Sections of one document extracted in parallel.
MANIFOLD_EXTRACTION_CONCURRENCY=4
# Stored vector size. Changing it, or OPENAI_EMBEDDING_MODEL, re-embeds the
# index in the background.
MANIFOLD_EMBEDDING_DIMENSIONS=512
MANIFOLD_PROVIDER_RETRY_INTERVAL=15m
# Jobs of different documents run in parallel up to this count; one
# document's jobs still run one at a time, and a rename runs alone.
MANIFOLD_WORKER_CONCURRENCY=2
MANIFOLD_MEMORY_LIMIT=1g
MANIFOLD_GOMEMLIMIT=384MiB
MANIFOLD_BUILD_VERSION=0.3.0
MANIFOLD_BUILD_COMMIT=unknown

OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=sk-replace-with-provider-key
OPENAI_CHAT_MODEL=gpt-4.1-mini
# JSON merged into every chat-completions request; fields a call sets itself
# win. Leave empty for OpenAI. For OpenRouter, disable hidden reasoning, route
# only to providers that honour json_schema, and prefer throughput:
# OPENAI_CHAT_EXTRA_BODY='{"reasoning":{"enabled":false},"provider":{"require_parameters":true,"sort":"throughput"}}'
OPENAI_CHAT_EXTRA_BODY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
