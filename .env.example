MANIFOLD_ADDR=:8080
MANIFOLD_DB_PATH=/var/lib/manifold/manifold.db
MANIFOLD_BOOTSTRAP_API_KEY=replace-with-a-long-random-secret
MANIFOLD_PUBLIC_URL=http://localhost:8080
MANIFOLD_LOG_LEVEL=info
MANIFOLD_MAX_BODY_BYTES=5242880
MANIFOLD_HTTP_TIMEOUT=30s
MANIFOLD_BRAIN_INGEST_TIMEOUT=2m
MANIFOLD_BUILD_VERSION=0.2.2
MANIFOLD_BUILD_COMMIT=unknown

OPENVIKING_URL=http://openviking:1933
OPENVIKING_API_KEY=replace-with-openviking-root-key

BRAIN_URL=http://brain:3000
BRAIN_API_KEY=replace-with-brain-key
BRAIN_API_KEYS_JSON=[{"keyHash":"sha256:4b8e44e82ad6e3722f0b35bccd2ea7cf7bf34ea5d221e5cfb25cb1ccd98264e2","companyId":"manifold","scopes":["brain:read","brain:write"]}]
FORGET_HMAC_KEY=replace-with-at-least-32-random-characters

SURREALDB_USERNAME=root
SURREALDB_PASSWORD=replace-with-surrealdb-password
SURREALDB_SCOPED_PASS=replace-with-scoped-database-password

OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=sk-replace-with-provider-key
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
