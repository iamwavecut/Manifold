diff --git a/test/bounded-name-scans.unit-spec.ts b/test/bounded-name-scans.unit-spec.ts
new file mode 100644
index 0000000..d26eb16
--- /dev/null
+++ b/test/bounded-name-scans.unit-spec.ts
@@ -0,0 +1,52 @@
+/**
+ * A commit asks about every mention of a document at once, and each name
+ * scan reads all entities of a type with their embeddings. Unbounded, one
+ * commit ran 37 such statements together and SurrealDB was killed for
+ * memory (2026-11-27). The statements wait for one of four slots.
+ */
+import { EntityCandidateService } from '../src/ingest/entity-candidates.service';
+
+function makeService() {
+  const config = { get: (_k: string, d?: string) => d } as never;
+  const embedder = { embed: async () => [0.1, 0.2] } as never;
+  const state = { running: 0, peak: 0, statements: 0 };
+  const db = {
+    query: async () => {
+      state.running += 1;
+      state.statements += 1;
+      state.peak = Math.max(state.peak, state.running);
+      await new Promise((r) => setTimeout(r, 2));
+      state.running -= 1;
+      return [[]];
+    },
+  } as never;
+  return { service: new EntityCandidateService(config, embedder), db, state };
+}
+
+describe('name scans', () => {
+  it('runs at most four statements at once, whatever the number of names', async () => {
+    const { service, db, state } = makeService();
+    const names = Array.from({ length: 20 }, (_, i) => `Quillon Basalt ${i}`);
+    await Promise.all(
+      names.map(async (name) => {
+        for (const scan of service.scans(db, { name, type: 'asset' })) await scan();
+      }),
+    );
+    // Key distance, name part, initials, one per word, embedding.
+    expect(state.statements).toBeGreaterThanOrEqual(names.length * 5);
+    expect(state.peak).toBe(4);
+  });
+
+  it('frees the slot of a statement that fails', async () => {
+    const { service, db, state } = makeService();
+    const failing = { query: async () => Promise.reject(new Error('boom')) } as never;
+    // More failures than there are slots.
+    for (let i = 0; i < 2; i++) {
+      for (const scan of service.nameScans(failing, { name: 'Acme Corp', type: 'asset' })) {
+        await scan();
+      }
+    }
+    for (const scan of service.nameScans(db, { name: 'Acme Corp', type: 'asset' })) await scan();
+    expect(state.statements).toBe(5);
+  });
+});
