diff --git a/src/db/migrations/9004_derived_version_index.surql b/src/db/migrations/9004_derived_version_index.surql
new file mode 100644
index 0000000..60d5cf8
--- /dev/null
+++ b/src/db/migrations/9004_derived_version_index.surql
@@ -0,0 +1,11 @@
+-- Manifold: drop the derivedVersion index (0074).
+--
+-- It serves derived worlds. Where there are none, `derivedVersion IS NONE`
+-- is true for every fact, yet SurrealDB 3.3 chooses this index for reads
+-- that also filter on entityId, scanning the whole table through it. On
+-- 51,000 facts one entity's candidate read took 39 s, against 1.3 s through
+-- fact_entity_idx (#828 fact resolution, search). A deployment that builds
+-- derived worlds should keep it: re-create with
+-- `DEFINE INDEX fact_derived_version_idx ON knowledge_fact FIELDS derivedVersion;`.
+
+REMOVE INDEX IF EXISTS fact_derived_version_idx ON knowledge_fact;
diff --git a/test/entity-fact-index-plans.unit-spec.ts b/test/entity-fact-index-plans.unit-spec.ts
index 87c6974..5179712 100644
--- a/test/entity-fact-index-plans.unit-spec.ts
+++ b/test/entity-fact-index-plans.unit-spec.ts
@@ -75,4 +75,10 @@ describe('entity and fact index plans', () => {
       /DEFINE INDEX IF NOT EXISTS \w+ ON knowledge_entity FIELDS nameKeys\[\*\];/,
     );
   });
+
+  it('drops the derivedVersion index, which every row of a tenant without derived worlds matches', () => {
+    expect(read('src/db/migrations/9004_derived_version_index.surql')).toContain(
+      'REMOVE INDEX IF EXISTS fact_derived_version_idx ON knowledge_fact;',
+    );
+  });
 });
