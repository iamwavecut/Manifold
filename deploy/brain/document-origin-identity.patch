+/**
+ * Manifold owns stable document/revision identities, so identical text in
+ * distinct revisions must remain distinct Brain origins. Other verticals
+ * retain their existing content-only dedupe semantics.
+ */
+export function documentContentHash(
+  text: string,
+  identity: {
+    vertical: string;
+    originUri?: string | undefined;
+    userId?: string | undefined;
+  },
+): string {
+  const originUri = identity.originUri;
+  const canonicalManifoldOrigin =
+    identity.vertical === 'manifold' &&
+    originUri !== undefined &&
+    /^manifold:\/\/documents\/[a-z0-9]+(?:-[a-z0-9]+)*@r[1-9]\d*$/.test(originUri)
+      ? originUri
+      : undefined;
+  const preimage =
+    canonicalManifoldOrigin === undefined
+      ? text
+      : `\u0000manifold-origin\u0000${canonicalManifoldOrigin}\u0000${text}`;
+  return identity.userId === undefined
+    ? sha256Hex(preimage)
+    : userScopedContentHash(identity.userId, preimage);
+}
