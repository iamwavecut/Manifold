+++ b/test/document-origin-identity.unit-spec.ts
@@ -0,0 +1,50 @@
+import {
+  documentContentHash,
+  sha256Hex,
+  userScopedContentHash,
+} from '../src/documents/document-store.service';
+
+describe('documentContentHash', () => {
+  const text = 'Mira Chen works at Meridian Labs.';
+
+  it('keeps retries on one canonical Manifold document revision idempotent', () => {
+    const identity = {
+      vertical: 'manifold',
+      originUri: 'manifold://documents/mira-notes@r1',
+    };
+
+    expect(documentContentHash(text, identity)).toBe(documentContentHash(text, identity));
+  });
+
+  it('separates identical text by Manifold document and revision identity', () => {
+    const first = { vertical: 'manifold', originUri: 'manifold://documents/first@r1' };
+    const anotherDocument = { vertical: 'manifold', originUri: 'manifold://documents/second@r1' };
+    const anotherRevision = { vertical: 'manifold', originUri: 'manifold://documents/first@r2' };
+
+    expect(documentContentHash(text, first)).not.toBe(documentContentHash(text, anotherDocument));
+    expect(documentContentHash(text, first)).not.toBe(documentContentHash(text, anotherRevision));
+  });
+
+  it('leaves non-Manifold and non-canonical origins byte-compatible', () => {
+    expect(documentContentHash(text, { vertical: 'meeting', originUri: 'meeting://doc/1' })).toBe(
+      sha256Hex(text),
+    );
+    expect(documentContentHash(text, { vertical: 'manifold', originUri: 'https://example.test/1' })).toBe(
+      sha256Hex(text),
+    );
+    expect(documentContentHash(text, { vertical: 'meeting', userId: 'user-1' })).toBe(
+      userScopedContentHash('user-1', text),
+    );
+  });
+
+  it('keeps user scope inside the Manifold origin salt', () => {
+    const identity = {
+      vertical: 'manifold',
+      originUri: 'manifold://documents/mira-notes@r1',
+    };
+
+    expect(documentContentHash(text, { ...identity, userId: 'user-1' })).not.toBe(
+      documentContentHash(text, { ...identity, userId: 'user-2' }),
+    );
+  });
+});
