+/**
+ * Undo FactsService.retractEdge: drop the knowledge-time close and the
+ * retraction record, and give back the end the relation had before it
+ * (none for a relation that still held). Guarded on the record, so a
+ * relation closed by supersession or by its own stated end stays closed.
+ * Returns the reopened period, or undefined when nothing was reopened.
+ */
+async function reopenRetractedEdge(db: Surreal, edgeId: string): Promise<EdgeIdRow | undefined> {
+  return queryFirst<EdgeIdRow>(
+    db,
+    `UPDATE $id SET
+        validUntil = IF type::is_datetime(source.retraction.priorValidUntil)
+          THEN source.retraction.priorValidUntil ELSE NONE END,
+        invalidatedAt = NONE,
+        source.retraction = NONE
+      WHERE invalidatedAt IS NOT NONE AND source.retraction IS NOT NONE
+      RETURN id, validFrom, validUntil`,
+    { id: new StringRecordId(edgeId) },
+  );
+}
