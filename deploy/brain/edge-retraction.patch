+  /**
+   * Retract a relation. A document commit returns the `knowledge_edge`
+   * id of every relation it wrote and search serves each live edge as a
+   * fact-shaped line (the relation leg), so an edge needs the same
+   * withdrawal route as a fact. The edge closes on both axes, like an
+   * explicitly superseded relation: `validUntil` (when it stopped
+   * holding, unless it already ended) and `invalidatedAt` (the
+   * current-state fence of every edge read). The retraction is recorded
+   * in `source.retraction`, together with the end the edge had, so a
+   * later statement of the same triple can reopen exactly this state
+   * (createEdgeBetween). Same ownership fence as a fact; an edge has no
+   * predicate class, so there is no admin-only subset. Idempotent.
+   */
+  private async retractEdge({
+    companyId,
+    factId,
+    dto,
+    callerScopes,
+  }: RetractOptions): Promise<RetractResult> {
+    return this.surreal.withCompany(companyId, async (db) => {
+      const rid = factId.slice('knowledge_edge:'.length);
+      const now = new Date();
+      const existing = await queryFirst<{ id: unknown; userId?: unknown; invalidatedAt?: unknown }>(
+        db,
+        `SELECT id, userId, invalidatedAt FROM type::record('knowledge_edge', $rid) LIMIT 1`,
+        { rid },
+      );
+      if (!existing) {
+        throw new NotFoundException(`Fact ${factId} not found`);
+      }
+      const retractUserScope = pinUserScope(undefined);
+      if (retractUserScope !== undefined) {
+        const owner =
+          typeof existing.userId === 'string' && existing.userId.length > 0
+            ? existing.userId
+            : undefined;
+        if (owner !== undefined && owner !== retractUserScope) {
+          throw new NotFoundException(`Fact ${factId} not found`);
+        }
+        if (owner === undefined && !callerScopes?.includes('brain:admin')) {
+          throw new ForbiddenException(
+            'retract of a tenant-global relation requires an M2M token or brain:admin',
+          );
+        }
+      }
+      if (existing.invalidatedAt) {
+        return {
+          factId: String(existing.id),
+          retractedAt: toIso(existing.invalidatedAt),
+          cascadedFactIds: [],
+          revivedFactIds: [],
+        };
+      }
+      await db.query(
+        `UPDATE type::record('knowledge_edge', $rid) SET
+            source.retraction = {
+              reason: $reason, by: $by, at: $now, priorValidUntil: validUntil ?? NULL
+            },
+            validUntil = validUntil ?? $now,
+            invalidatedAt = $now
+          WHERE invalidatedAt IS NONE`,
+        { rid, reason: dto.reason, by: dto.retractedBy.source, now },
+      );
+      this.logger.log(`[knowledge.edge.retracted] companyId=${companyId} edgeId=${existing.id}`);
+      this.metrics?.countRetract();
+      return {
+        factId: String(existing.id),
+        retractedAt: now.toISOString(),
+        cascadedFactIds: [],
+        revivedFactIds: [],
+      };
+    });
+  }
