diff --git a/test/extractor-output.unit-spec.ts b/test/extractor-output.unit-spec.ts
new file mode 100644
index 0000000..7fa2be6
--- /dev/null
+++ b/test/extractor-output.unit-spec.ts
@@ -0,0 +1,48 @@
+import { ConfigService } from '@nestjs/config';
+import { ExtractorLlmService } from '../src/ai/extractor-llm.service';
+
+const empty = { clauses: [], entities: [], facts: [], edges: [] };
+function fixture(content: string | null, finishReason = 'stop', budget?: string) {
+  const config = new ConfigService({
+    OPENAI_API_KEY: 'sk-test-stub',
+    OPENAI_CHAT_MODEL: 'gpt-4.1-mini',
+    ...(budget ? { EXTRACTOR_MAX_COMPLETION_TOKENS: budget } : {}),
+  });
+  const service = new ExtractorLlmService(config);
+  const create = jest.fn().mockResolvedValue({
+    choices: [{ message: { content }, finish_reason: finishReason }],
+  });
+  Object.defineProperty(service, 'openai', { value: { chat: { completions: { create } } } });
+  return { service, create };
+}
+const args = {
+  trimmed: 'Synthetic extraction fixture.',
+  systemPrompt: 'Return structured knowledge.',
+};
+
+describe('extractor completion integrity', () => {
+  it.each([undefined, '12000'])(
+    'uses a bounded document-sized output budget: %s',
+    async (budget) => {
+      const { service, create } = fixture(JSON.stringify(empty), 'stop', budget);
+      await expect(service.callLlm(args)).resolves.toEqual(empty);
+      expect(create.mock.calls[0]?.[0].max_completion_tokens).toBe(Number(budget ?? '16384'));
+    },
+  );
+  it.each([
+    ['truncated JSON', '{"clauses":[', 'length'],
+    ['truncated but parseable response', JSON.stringify(empty), 'length'],
+    ['malformed JSON', '{broken', 'stop'],
+    ['empty content', null, 'stop'],
+    ['missing arrays', '{}', 'stop'],
+    ['wrong array types', '{"clauses":[],"entities":{},"facts":[],"edges":[]}', 'stop'],
+  ])('rejects %s instead of accepting an empty extraction', async (_name, content, reason) => {
+    const { service } = fixture(content, reason ?? 'stop');
+    await expect(service.callLlm(args)).rejects.toThrow('incomplete extraction');
+  });
+  it.each(['0', '-1', 'NaN', '65537'])('rejects invalid output budget %s', (budget) => {
+    expect(() => fixture(JSON.stringify(empty), 'stop', budget)).toThrow(
+      'EXTRACTOR_MAX_COMPLETION_TOKENS',
+    );
+  });
+});
