+import { IndexerDispatchService } from '../src/documents/indexer-dispatch.service';
+import type { IndexerRouterService } from '../src/indexers/indexer-router.service';
+import type { IndexerRunService } from '../src/documents/indexer-run.service';
+import type { DedicatedExtractorService } from '../src/indexers/dedicated-extractor.service';
+import type { IndexerWebhookService } from '../src/documents/indexer-webhook.service';
+import type { StoredDocument } from '../src/documents/document-store.service';
+
+describe('IndexerDispatchService retry version pinning', () => {
+  it('skips a queued retry when the installed binding has since changed versions', async () => {
+    const binding = {
+      indexerId: 'pack_retry_version',
+      packVersion: '2.0.0',
+      mode: 'dedicated' as const,
+      description: 'Retry version fixture',
+    };
+    const router = {
+      bindingsFor: jest.fn().mockResolvedValue([binding]),
+    } as unknown as IndexerRouterService;
+    const runs = {
+      runIndexer: jest.fn().mockResolvedValue({
+        runId: 'indexer_run:retry-version',
+        packId: binding.indexerId,
+        status: 'succeeded',
+      }),
+    } as unknown as IndexerRunService;
+    const dispatch = new IndexerDispatchService(
+      router,
+      runs,
+      { modelId: () => 'test-model' } as unknown as DedicatedExtractorService,
+      {} as IndexerWebhookService,
+    );
+    const doc: StoredDocument = {
+      id: 'source_document:retry-version',
+      kind: 'markdown',
+      contentHash: 'hash',
+      charLen: 1,
+      chunkCount: 1,
+      hasContent: true,
+      vertical: 'retry_version',
+      occurredAt: new Date('2026-09-16T12:00:00.000Z'),
+      status: 'failed',
+    };
+    const input: Parameters<IndexerDispatchService['runOne']>[0] & {
+      expectedPackVersion: string;
+    } = {
+      companyId: 'co_retry_version',
+      doc,
+      chunks: [{ seq: 0, text: 'x', charStart: 0, charEnd: 1 }],
+      packId: binding.indexerId,
+      expectedPackVersion: '1.0.0',
+    };
+
+    const result = await dispatch.runOne(input);
+
+    expect(result.status).toBe('skipped');
+    expect(runs.runIndexer).not.toHaveBeenCalled();
+  });
+});
