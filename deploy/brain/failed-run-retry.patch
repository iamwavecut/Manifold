+import { DocumentAsyncService } from '../src/documents/document-async.service';
+import type { DocumentStoreService, StoredDocument } from '../src/documents/document-store.service';
+import type { IndexerDispatchService } from '../src/documents/indexer-dispatch.service';
+import type { CandidateCommitService } from '../src/documents/candidate-commit.service';
+import type { CandidateStoreService } from '../src/documents/candidate-store.service';
+import type { JobClaimService } from '../src/jobs/job-claim.service';
+import type { JobContext } from '../src/jobs/worker-loop.service';
+import type { WorkerLoopService } from '../src/jobs/worker-loop.service';
+
+type Handler = (ctx: JobContext) => Promise<Record<string, unknown> | void>;
+
+describe('DocumentAsyncService retry jobs', () => {
+  it('carries retryKey into the follow-on commit dedup key', async () => {
+    const doc: StoredDocument = {
+      id: 'source_document:retry-unit',
+      kind: 'markdown',
+      contentHash: 'hash',
+      charLen: 3,
+      chunkCount: 1,
+      hasContent: true,
+      vertical: 'retry_unit',
+      occurredAt: new Date('2026-09-16T12:00:00.000Z'),
+      status: 'failed',
+    };
+    const store = {
+      getById: jest.fn().mockResolvedValue(doc),
+      getChunks: jest.fn().mockResolvedValue([{ seq: 0, text: 'one', charStart: 0, charEnd: 3 }]),
+    } as unknown as DocumentStoreService;
+    const dispatch = {
+      runOne: jest.fn().mockResolvedValue({
+        runId: 'indexer_run:retry-unit',
+        packId: 'pack_retry_unit',
+        status: 'failed',
+      }),
+    } as unknown as IndexerDispatchService;
+    const enqueue = jest.fn().mockResolvedValue({ runId: 'job_run:commit-unit', created: true });
+    const claim = { enqueue } as unknown as JobClaimService;
+    let indexHandler: Handler | undefined;
+    const workerLoop = {
+      register: (jobType: string, handler: Handler) => {
+        if (jobType === 'index_document') indexHandler = handler;
+      },
+    } as unknown as WorkerLoopService;
+    const service = new DocumentAsyncService(
+      store,
+      dispatch,
+      {} as CandidateCommitService,
+      {} as CandidateStoreService,
+      workerLoop,
+      claim,
+    );
+    service.onModuleInit();
+    expect(indexHandler).toBeDefined();
+
+    const retryKey = 'job-01ab2cd3efgh-attempt-1';
+    await indexHandler!({
+      runId: 'job_run:index-unit',
+      jobType: 'index_document',
+      companyId: 'co_retry_unit',
+      payload: { docId: doc.id, packId: 'pack_retry_unit', packVersion: 'v1', retryKey },
+      attempts: 1,
+      abortSignal: new AbortController().signal,
+      workerId: 'test-worker',
+    });
+
+    expect(enqueue).toHaveBeenCalledWith({
+      jobType: 'commit_document',
+      companyId: 'co_retry_unit',
+      triggeredBy: 'manual',
+      dedupKey: 'commit_' + doc.id + '_pack_retry_unit_retry_' + retryKey,
+      payload: { docId: doc.id },
+    });
+    expect(dispatch.runOne).toHaveBeenCalledWith(
+      expect.objectContaining({ packId: 'pack_retry_unit', expectedPackVersion: 'v1' }),
+    );
+  });
+
+  it('leaves the existing commit dedup key unchanged for normal jobs', async () => {
+    const doc: StoredDocument = {
+      id: 'source_document:normal-unit',
+      kind: 'markdown',
+      contentHash: 'hash',
+      charLen: 3,
+      chunkCount: 1,
+      hasContent: true,
+      vertical: 'retry_unit',
+      occurredAt: new Date('2026-09-16T12:00:00.000Z'),
+      status: 'indexing',
+    };
+    const store = {
+      getById: jest.fn().mockResolvedValue(doc),
+      getChunks: jest.fn().mockResolvedValue([{ seq: 0, text: 'one', charStart: 0, charEnd: 3 }]),
+    } as unknown as DocumentStoreService;
+    const dispatch = {
+      runOne: jest.fn().mockResolvedValue({
+        runId: 'indexer_run:normal-unit',
+        packId: 'pack_normal_unit',
+        status: 'succeeded',
+      }),
+    } as unknown as IndexerDispatchService;
+    const enqueue = jest.fn().mockResolvedValue({ runId: 'job_run:commit-unit', created: true });
+    const workerLoop = {
+      register: jest.fn(),
+    } as unknown as WorkerLoopService;
+    const service = new DocumentAsyncService(
+      store,
+      dispatch,
+      {} as CandidateCommitService,
+      {} as CandidateStoreService,
+      workerLoop,
+      { enqueue } as unknown as JobClaimService,
+    );
+    service.onModuleInit();
+    const indexHandler = (workerLoop.register as unknown as jest.Mock).mock.calls.find(
+      ([jobType]: [string]) => jobType === 'index_document',
+    )?.[1] as Handler | undefined;
+    expect(indexHandler).toBeDefined();
+
+    await indexHandler!({
+      runId: 'job_run:normal-index',
+      jobType: 'index_document',
+      companyId: 'co_retry_unit',
+      payload: { docId: doc.id, packId: 'pack_normal_unit' },
+      attempts: 1,
+      abortSignal: new AbortController().signal,
+      workerId: 'test-worker',
+    });
+
+    expect(enqueue).toHaveBeenCalledWith(
+      expect.objectContaining({
+        jobType: 'commit_document',
+        dedupKey: 'commit_' + doc.id + '_pack_normal_unit',
+      }),
+    );
+  });
+});
