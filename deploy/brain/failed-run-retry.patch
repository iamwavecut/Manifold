@@ -0,0 +1,506 @@
+import { randomUUID } from 'node:crypto';
+import { AppFixture, createApp } from './app-fixture';
+import { CandidateStoreService } from '../src/documents/candidate-store.service';
+import { CandidateCommitService } from '../src/documents/candidate-commit.service';
+import { DocumentAsyncService } from '../src/documents/document-async.service';
+import { DocumentStoreService } from '../src/documents/document-store.service';
+import { SurrealService } from '../src/db/surreal.service';
+import { GENERAL_INDEXER_ID } from '../src/indexers/candidate.types';
+import type { JobContext } from '../src/jobs/worker-loop.service';
+
+type RetryJobRow = {
+  dedupKey?: string;
+  payload?: Record<string, unknown> | null;
+};
+
+describe('failed document retry (e2e)', () => {
+  let f: AppFixture;
+  let candidates: CandidateStoreService;
+  let documents: DocumentStoreService;
+  const previousEnv = new Map<string, string | undefined>();
+  const writeKey = () => f.extraApiKeys[0]!;
+  const userBKey = () => f.extraApiKeys[1]!;
+  const auth = (key: string) => ({ Authorization: 'Bearer ' + key });
+  const retryPath = (docId: string) => '/v1/documents/' + encodeURIComponent(docId) + '/retry';
+
+  beforeAll(async () => {
+    for (const name of [
+      'DOCUMENT_INGEST_ENABLED',
+      'DOCUMENT_MULTI_INDEXER_ENABLED',
+      'WORKER_LOOP_ENABLED',
+    ]) {
+      previousEnv.set(name, process.env[name]);
+    }
+    process.env.DOCUMENT_INGEST_ENABLED = '1';
+    process.env.DOCUMENT_MULTI_INDEXER_ENABLED = '1';
+    process.env.WORKER_LOOP_ENABLED = '0';
+    f = await createApp({
+      companyId: 'co_document_retry_e2e',
+      scopes: ['brain:read'],
+      extraKeys: [{ scopes: ['brain:write'] }, { scopes: ['brain:write'], userId: 'retry-user-b' }],
+    });
+    candidates = f.app.get(CandidateStoreService);
+    documents = f.app.get(DocumentStoreService);
+  });
+
+  afterAll(async () => {
+    if (f) await f.close();
+    for (const [name, value] of previousEnv) {
+      if (value === undefined) delete process.env[name];
+      else process.env[name] = value;
+    }
+  });
+
+  async function makeDoc(userId?: string): Promise<string> {
+    const { doc } = await documents.createOrGet(f.companyId, {
+      kind: 'markdown',
+      text: 'Document retry fixture ' + randomUUID(),
+      occurredAt: '2026-09-16T12:00:00.000Z',
+      contextRef: { vertical: 'document_retry_e2e' },
+      ...(userId ? { userId } : {}),
+    });
+    return doc.id;
+  }
+
+  async function seedRun(
+    docId: string,
+    p: {
+      packId: string;
+      status: 'pending' | 'running' | 'failed' | 'succeeded';
+      external?: boolean;
+      packVersion?: string;
+    },
+  ): Promise<void> {
+    const run = {
+      docId,
+      packId: p.packId,
+      packVersion: p.packVersion ?? 'v1',
+      ...(p.external ? { external: true } : {}),
+    };
+    if (p.status === 'pending') {
+      await candidates.ensureRunPending(f.companyId, run);
+      return;
+    }
+    const created = await candidates.createRun(f.companyId, run);
+    expect(created.created).toBe(true);
+    if (p.status === 'failed' || p.status === 'succeeded') {
+      await candidates.finalizeRun(f.companyId, {
+        runId: created.runId,
+        status: p.status,
+      });
+    }
+  }
+
+  async function indexJobs(docId: string): Promise<RetryJobRow[]> {
+    const surreal = f.app.get(SurrealService);
+    return surreal.withCompany(f.companyId, async (db) => {
+      const [rows] = await db.query<[RetryJobRow[]]>(
+        'SELECT dedupKey, payload FROM job_run WHERE jobType = $jobType',
+        { jobType: 'index_document' },
+      );
+      return (rows as RetryJobRow[]).filter((row) => row.payload?.docId === docId);
+    });
+  }
+
+  async function commitJobs(docId: string): Promise<RetryJobRow[]> {
+    const surreal = f.app.get(SurrealService);
+    return surreal.withCompany(f.companyId, async (db) => {
+      const [rows] = await db.query<[RetryJobRow[]]>(
+        'SELECT dedupKey, payload FROM job_run WHERE jobType = $jobType',
+        { jobType: 'commit_document' },
+      );
+      return (rows as RetryJobRow[]).filter((row) => row.payload?.docId === docId);
+    });
+  }
+
+  it('queues a failed internal run with a stable retry key and replays idempotently', async () => {
+    const docId = await makeDoc();
+    await seedRun(docId, {
+      packId: GENERAL_INDEXER_ID,
+      packVersion: '0',
+      status: 'failed',
+    });
+    const retryKey = 'job-01ab2cd3efgh-attempt-1';
+
+    const first = await f.http.post(retryPath(docId)).set(auth(writeKey())).send({ retryKey });
+    expect(first.status).toBe(202);
+    expect(first.body.runs).toEqual([
+      { packId: GENERAL_INDEXER_ID, packVersion: '0', status: 'enqueued' },
+    ]);
+
+    const replay = await f.http.post(retryPath(docId)).set(auth(writeKey())).send({ retryKey });
+    expect(replay.status).toBe(202);
+    expect(replay.body.runs).toEqual([
+      { packId: GENERAL_INDEXER_ID, packVersion: '0', status: 'already_queued' },
+    ]);
+
+    const jobs = await indexJobs(docId);
+    expect(jobs).toHaveLength(1);
+    expect(jobs[0]?.dedupKey).toContain('_retry_' + retryKey);
+    expect(jobs[0]?.payload).toMatchObject({
+      docId,
+      packId: GENERAL_INDEXER_ID,
+      packVersion: '0',
+      retryKey,
+    });
+    expect((await documents.getById(f.companyId, docId))?.status).toBe('indexing');
+
+    const invalid = await f.http
+      .post(retryPath(docId))
+      .set(auth(writeKey()))
+      .send({ retryKey: 'x'.repeat(129) });
+    expect(invalid.status).toBe(400);
+    expect(await indexJobs(docId)).toHaveLength(1);
+
+    const invalidChars = await f.http
+      .post(retryPath(docId))
+      .set(auth(writeKey()))
+      .send({ retryKey: 'bad key' });
+    expect(invalidChars.status).toBe(400);
+    expect(await indexJobs(docId)).toHaveLength(1);
+  });
+
+  it('skips a failed run whose installed pack version has changed', async () => {
+    const packId = 'pack_retry_version_' + randomUUID().replaceAll('-', '_');
+    const surreal = f.app.get(SurrealService);
+    await surreal.withCompany(f.companyId, async (db) => {
+      await db.query(`CREATE domain_pack CONTENT $content`, {
+        content: {
+          packId,
+          version: '2.0.0',
+          status: 'active',
+          manifest: {
+            id: packId,
+            version: '2.0.0',
+            description: 'Retry version fixture',
+            indexer: { mode: 'dedicated' },
+            predicates: [],
+          },
+        },
+      });
+    });
+    const docId = await makeDoc();
+    await seedRun(docId, { packId, packVersion: '1.0.0', status: 'failed' });
+    const previousStatus = (await documents.getById(f.companyId, docId))?.status;
+
+    const response = await f.http
+      .post(retryPath(docId))
+      .set(auth(writeKey()))
+      .send({ retryKey: 'old-pack-version' });
+
+    expect(response.status).toBe(202);
+    expect(response.body.runs).toEqual([
+      { packId, packVersion: '1.0.0', status: 'skipped_version_mismatch' },
+    ]);
+    expect(await indexJobs(docId)).toHaveLength(0);
+    expect((await documents.getById(f.companyId, docId))?.status).toBe(previousStatus);
+  });
+
+  it('rejects retries after content is purged without queueing or changing the header', async () => {
+    const docId = await makeDoc();
+    await seedRun(docId, {
+      packId: GENERAL_INDEXER_ID,
+      packVersion: '0',
+      status: 'failed',
+    });
+    await documents.purgeContent(f.companyId, docId);
+
+    const response = await f.http
+      .post(retryPath(docId))
+      .set(auth(writeKey()))
+      .send({ retryKey: 'purged-content' });
+
+    expect(response.status).toBe(409);
+    expect(await indexJobs(docId)).toHaveLength(0);
+    expect((await documents.getById(f.companyId, docId))?.status).toBe('purged');
+  });
+
+  it('keeps a purged document terminal when content is purged after retry acceptance', async () => {
+    const docId = await makeDoc();
+    await seedRun(docId, {
+      packId: GENERAL_INDEXER_ID,
+      packVersion: '0',
+      status: 'failed',
+    });
+    const response = await f.http
+      .post(retryPath(docId))
+      .set(auth(writeKey()))
+      .send({ retryKey: 'purge-after-acceptance' });
+    expect(response.status).toBe(202);
+    const queued = await indexJobs(docId);
+    expect(queued).toHaveLength(1);
+
+    await documents.purgeContent(f.companyId, docId);
+    const service = f.app.get(DocumentAsyncService) as unknown as {
+      handleIndexJob(ctx: JobContext): Promise<Record<string, unknown>>;
+    };
+    const result = await service.handleIndexJob({
+      runId: 'job_run:purge-race',
+      jobType: 'index_document',
+      companyId: f.companyId,
+      payload: queued[0]?.payload ?? {},
+      attempts: 1,
+      abortSignal: new AbortController().signal,
+      workerId: 'retry-e2e',
+    });
+
+    expect(result).toEqual({ skipped: 'no_stored_content' });
+    expect(await commitJobs(docId)).toHaveLength(0);
+    expect((await documents.getById(f.companyId, docId))?.status).toBe('purged');
+  });
+
+  it('does not auto-commit candidates staged after purge during extraction', async () => {
+    const docId = await makeDoc();
+    await seedRun(docId, {
+      packId: GENERAL_INDEXER_ID,
+      packVersion: '0',
+      status: 'failed',
+    });
+    const accepted = await f.http
+      .post(retryPath(docId))
+      .set(auth(writeKey()))
+      .send({ retryKey: 'purge-during-extraction' });
+    expect(accepted.status).toBe(202);
+    const queued = await indexJobs(docId);
+    expect(queued).toHaveLength(1);
+
+    let markExtractionStarted!: () => void;
+    let resumeExtraction!: () => void;
+    const extractionStarted = new Promise<void>((resolve) => {
+      markExtractionStarted = resolve;
+    });
+    const extractionGate = new Promise<void>((resolve) => {
+      resumeExtraction = resolve;
+    });
+    const extraction = jest.spyOn(f.extractor, 'extract').mockImplementation(async () => {
+      markExtractionStarted();
+      await extractionGate;
+      return {
+        entities: [{ name: 'Late extraction entity', type: 'topic' }],
+        facts: [],
+        edges: [],
+      };
+    });
+    const service = f.app.get(DocumentAsyncService) as unknown as {
+      handleIndexJob(ctx: JobContext): Promise<Record<string, unknown>>;
+      handleCommitJob(ctx: JobContext): Promise<Record<string, unknown>>;
+    };
+    const indexContext: JobContext = {
+      runId: 'job_run:purge-race-index',
+      jobType: 'index_document',
+      companyId: f.companyId,
+      payload: queued[0]?.payload ?? {},
+      attempts: 1,
+      abortSignal: new AbortController().signal,
+      workerId: 'retry-e2e',
+    };
+
+    let indexPromise: Promise<Record<string, unknown>> | undefined;
+    try {
+      indexPromise = service.handleIndexJob(indexContext);
+      await extractionStarted;
+      await documents.purgeContent(f.companyId, docId);
+      resumeExtraction();
+      expect(await indexPromise).toMatchObject({ packId: GENERAL_INDEXER_ID, status: 'succeeded' });
+
+      const staged = await candidates.listByDoc(f.companyId, docId);
+      expect(staged.some((candidate) => candidate.status === 'pending')).toBe(true);
+      expect(await commitJobs(docId)).toHaveLength(0);
+
+      const commitService = f.app.get(CandidateCommitService);
+      const commitAttempt = jest.spyOn(commitService, 'commitIfRunsSettled').mockResolvedValue({
+        committed: false,
+        deferred: false,
+        entityIds: [],
+        factIds: [],
+        edgeIds: [],
+        counts: { pending: 0, committed: 0, merged: 0, rejected: 0 },
+      });
+      try {
+        const commitContext: JobContext = {
+          ...indexContext,
+          runId: 'job_run:purge-race-commit',
+          jobType: 'commit_document',
+          payload: { docId },
+        };
+        expect(await service.handleCommitJob(commitContext)).toEqual({
+          skipped: 'no_stored_content',
+        });
+        expect(commitAttempt).not.toHaveBeenCalled();
+        expect((await documents.getById(f.companyId, docId))?.status).toBe('purged');
+      } finally {
+        commitAttempt.mockRestore();
+      }
+    } finally {
+      resumeExtraction();
+      if (indexPromise) await indexPromise.catch(() => undefined);
+      extraction.mockRestore();
+    }
+  });
+
+  it('does not restore committed status if purge wins during async commit', async () => {
+    const docId = await makeDoc();
+    let markCommitStarted!: () => void;
+    let resumeCommit!: () => void;
+    const commitStarted = new Promise<void>((resolve) => {
+      markCommitStarted = resolve;
+    });
+    const commitGate = new Promise<void>((resolve) => {
+      resumeCommit = resolve;
+    });
+    const commitService = f.app.get(CandidateCommitService);
+    const commitAttempt = jest
+      .spyOn(commitService, 'commitIfRunsSettled')
+      .mockImplementation(async () => {
+        markCommitStarted();
+        await commitGate;
+        return {
+          committed: true,
+          deferred: false,
+          entityIds: [],
+          factIds: [],
+          edgeIds: [],
+          counts: { pending: 1, committed: 1, merged: 0, rejected: 0 },
+        };
+      });
+    const service = f.app.get(DocumentAsyncService) as unknown as {
+      handleCommitJob(ctx: JobContext): Promise<Record<string, unknown>>;
+    };
+    const commitContext: JobContext = {
+      runId: 'job_run:purge-during-commit',
+      jobType: 'commit_document',
+      companyId: f.companyId,
+      payload: { docId },
+      attempts: 1,
+      abortSignal: new AbortController().signal,
+      workerId: 'retry-e2e',
+    };
+    let handlerPromise: Promise<Record<string, unknown>> | undefined;
+
+    try {
+      handlerPromise = service.handleCommitJob(commitContext);
+      await commitStarted;
+      await documents.purgeContent(f.companyId, docId);
+      resumeCommit();
+
+      expect(await handlerPromise).toMatchObject({ committed: true });
+      expect((await documents.getById(f.companyId, docId))?.status).toBe('purged');
+    } finally {
+      resumeCommit();
+      if (handlerPromise) await handlerPromise.catch(() => undefined);
+      commitAttempt.mockRestore();
+    }
+  });
+
+  it('does not change the header to indexing if a purge wins the status update race', async () => {
+    const docId = await makeDoc();
+    await documents.purgeContent(f.companyId, docId);
+
+    expect(
+      await documents.setStatusIfContentAvailable({
+        companyId: f.companyId,
+        docId,
+        status: 'indexing',
+      }),
+    ).toBe(false);
+    expect((await documents.getById(f.companyId, docId))?.status).toBe('purged');
+  });
+
+  it('ignores pending, running, succeeded and failed external runs', async () => {
+    const cases = [
+      { packId: 'pack_retry_pending', status: 'pending' as const },
+      { packId: 'pack_retry_running', status: 'running' as const },
+      { packId: 'pack_retry_succeeded', status: 'succeeded' as const },
+      { packId: 'pack_retry_external', status: 'failed' as const, external: true },
+    ];
+    for (const item of cases) {
+      const docId = await makeDoc();
+      await seedRun(docId, item);
+      const response = await f.http
+        .post(retryPath(docId))
+        .set(auth(writeKey()))
+        .send({ retryKey: 'state-' + item.packId });
+      expect(response.status).toBe(202);
+      expect(response.body.runs).toEqual([]);
+      expect(await indexJobs(docId)).toHaveLength(0);
+    }
+  });
+
+  it('requires brain:write and hides missing, cross-user and cross-tenant documents', async () => {
+    const userDoc = await makeDoc('retry-user-a');
+    await seedRun(userDoc, { packId: 'pack_retry_auth', status: 'failed' });
+
+    const anonymous = await f.http.post(retryPath(userDoc)).send({ retryKey: 'anon-1' });
+    expect(anonymous.status).toBe(401);
+
+    const missing = await f.http
+      .post(retryPath('source_document:missing-retry-doc'))
+      .set(auth(writeKey()))
+      .send({ retryKey: 'missing-1' });
+    expect(missing.status).toBe(404);
+
+    const readOnly = await f.http
+      .post(retryPath(userDoc))
+      .set(auth(f.apiKey))
+      .send({ retryKey: 'readonly-1' });
+    expect(readOnly.status).toBe(403);
+
+    const crossUser = await f.http
+      .post(retryPath(userDoc))
+      .set(auth(userBKey()))
+      .send({ retryKey: 'cross-user-1' });
+    expect(crossUser.status).toBe(404);
+
+    const otherTenant = await createApp({
+      companyId: 'co_document_retry_other',
+      scopes: ['brain:write'],
+    });
+    try {
+      const crossTenant = await otherTenant.http
+        .post(retryPath(userDoc))
+        .set(auth(otherTenant.apiKey))
+        .send({ retryKey: 'cross-tenant-1' });
+      expect(crossTenant.status).toBe(404);
+    } finally {
+      await otherTenant.close();
+    }
+
+    expect(await indexJobs(userDoc)).toHaveLength(0);
+  });
+
+  it('allows different retry keys to race while the run-ledger CAS admits one worker', async () => {
+    const docId = await makeDoc();
+    await seedRun(docId, {
+      packId: GENERAL_INDEXER_ID,
+      packVersion: '0',
+      status: 'failed',
+    });
+
+    const requests = await Promise.all(
+      ['race-a', 'race-b'].map((retryKey) =>
+        f.http.post(retryPath(docId)).set(auth(writeKey())).send({ retryKey }),
+      ),
+    );
+    expect(requests.map((response) => response.status)).toEqual([202, 202]);
+    expect(await indexJobs(docId)).toHaveLength(2);
+
+    const opened = await Promise.all(
+      Array.from({ length: 2 }, () =>
+        candidates.createRun(f.companyId, {
+          docId,
+          packId: GENERAL_INDEXER_ID,
+          packVersion: '0',
+        }),
+      ),
+    );
+    expect(opened.filter((run) => run.created)).toHaveLength(1);
+
+    const whileRunning = await f.http
+      .post(retryPath(docId))
+      .set(auth(writeKey()))
+      .send({ retryKey: 'race-c' });
+    expect(whileRunning.status).toBe(202);
+    expect(whileRunning.body.runs).toEqual([]);
+    expect(await indexJobs(docId)).toHaveLength(2);
+  });
+});
