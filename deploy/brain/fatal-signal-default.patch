diff --git a/src/main.ts b/src/main.ts
index 43d4dd5..89f7aa5 100644
--- a/src/main.ts
+++ b/src/main.ts
@@ -88,7 +88,13 @@ async function bootstrap() {
   // drain, the hard-stop deadline and the OTel flush inside that
   // lifecycle — a second SIGTERM listener here ran app.close()
   // concurrently with Nest's own run of the same hooks.
-  app.enableShutdownHooks();
+  //
+  // The signal list is explicit: without it Nest also listens for SIGSEGV,
+  // SIGBUS, SIGILL and SIGFPE. A real fault in a native addon (onnxruntime)
+  // then returns from libuv's handler and re-faults forever while the
+  // shutdown lifecycle closes the HTTP listener. Fatal signals must keep
+  // their default action so the container exits and restarts.
+  app.enableShutdownHooks(['SIGTERM', 'SIGINT']);
   const configService = app.get(ConfigService);
   const bootLog = new Logger('Bootstrap');
 
diff --git a/test/graceful-shutdown.unit-spec.ts b/test/graceful-shutdown.unit-spec.ts
index 69db6cc..4798d6f 100644
--- a/test/graceful-shutdown.unit-spec.ts
+++ b/test/graceful-shutdown.unit-spec.ts
@@ -95,7 +95,9 @@ describe('GracefulShutdownService', () => {
     // own; a lingering one would swallow the exit Nest re-raises.
     expect(main).not.toMatch(/process\.(on|once)\(\s*'SIG/);
     expect(tracing).not.toMatch(/process\.(on|once)\(\s*'SIG/);
-    expect(main).toContain('app.enableShutdownHooks()');
+    // Only the signals that ask for a shutdown: a fatal fault must keep its
+    // default action instead of starting a graceful drain.
+    expect(main).toContain("app.enableShutdownHooks(['SIGTERM', 'SIGINT'])");
     expect(appModule).toMatch(/providers:\s*\[[\s\S]*GracefulShutdownService[\s\S]*\]/);
   });
 });
