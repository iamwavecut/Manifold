--- /dev/null
+++ b/test/ledger-release.e2e-spec.ts
@@ -0,0 +1,86 @@
+/**
+ * Manifold's earlier build recorded its own migrations as 0168-0170, the ids
+ * upstream later used. The migrator selects files by id, so it must forget
+ * those rows or it would never run upstream's 0168-0170 on that database.
+ */
+import { Surreal } from 'surrealdb';
+import { join } from 'node:path';
+import { SchemaMigrator } from '../src/db/migrator.service';
+
+/** Own namespace: the shared container also hosts every other e2e spec. */
+const NS = `mig_release_${Date.now()}`;
+const DIR = join(__dirname, '../src/db/migrations');
+const OLD = [
+  '0168_resolve_fact_entity_index.surql',
+  '0169_selective_entity_fact_indexes.surql',
+  '0170_derived_from_element_index.surql',
+];
+
+async function connect(database: string): Promise<Surreal> {
+  const db = new Surreal();
+  await db.connect(process.env.SURREALDB_URL!);
+  await db.signin({
+    username: process.env.SURREALDB_USERNAME ?? 'root',
+    password: process.env.SURREALDB_PASSWORD ?? 'root',
+  });
+  await db.query(`DEFINE NAMESPACE IF NOT EXISTS \`${NS}\``);
+  await db.use({ namespace: NS });
+  await db.query(`DEFINE DATABASE IF NOT EXISTS \`${database}\``);
+  await db.use({ namespace: NS, database });
+  return db;
+}
+
+async function ledger(conn: Surreal) {
+  const [rows] = await conn.query<[Array<{ migrationId: string; name: string }>]>(
+    `SELECT migrationId, name FROM schema_migrations`,
+  );
+  return rows ?? [];
+}
+
+describe('ledger rows of the earlier local migrations (real SurrealDB)', () => {
+  let conn: Surreal;
+
+  beforeAll(async () => {
+    conn = await connect('co_release');
+    await conn.query(
+      `DEFINE TABLE IF NOT EXISTS schema_migrations SCHEMAFULL;
+       DEFINE FIELD IF NOT EXISTS migrationId ON schema_migrations TYPE string;
+       DEFINE FIELD IF NOT EXISTS name        ON schema_migrations TYPE string;
+       DEFINE FIELD IF NOT EXISTS appliedAt   ON schema_migrations TYPE datetime DEFAULT time::now();`,
+    );
+    for (const name of OLD) {
+      await conn.query(`CREATE schema_migrations CONTENT { migrationId: $id, name: $name }`, {
+        id: name.slice(0, 4),
+        name,
+      });
+    }
+  });
+
+  afterAll(async () => {
+    await conn?.close().catch(() => undefined);
+    const root = await connect('cleanup');
+    await root.query(`REMOVE NAMESPACE IF EXISTS \`${NS}\``).catch(() => undefined);
+    await root.close();
+  });
+
+  it('applies upstream 0168-0170 over a ledger with the old local ids', async () => {
+    await new SchemaMigrator(DIR).migrate(conn);
+
+    const rows = await ledger(conn);
+    expect(rows.filter((r) => OLD.includes(r.name))).toEqual([]);
+    const nameOf = (id: string) => rows.filter((r) => r.migrationId === id).map((r) => r.name);
+    expect(nameOf('0168')).toEqual(['0168_indexer_run_priority.surql']);
+    expect(nameOf('0169')).toEqual(['0169_membership_plane.surql']);
+    expect(nameOf('0170')).toEqual(['0170_progressive_catalogue.surql']);
+    const [info] = await conn.query<[{ tables: Record<string, string> }]>(`INFO FOR DB`);
+    expect(Object.keys(info.tables)).toContain('external_identity');
+    expect(nameOf('9001')).toEqual(['9001_settle_fact_entity_index.surql']);
+    expect(nameOf('9002')).toEqual(['9002_selective_entity_fact_indexes.surql']);
+    expect(nameOf('9003')).toEqual(['9003_derived_from_element_index.surql']);
+  });
+
+  it('applies nothing on the next run', async () => {
+    const again = await new SchemaMigrator(DIR).migrate(conn);
+    expect(again.applied).toEqual([]);
+  });
+});
