+/**
+ * Fields merged into every chat-completions request body, for an
+ * OpenAI-compatible router whose controls live outside the OpenAI schema —
+ * OpenRouter's `reasoning` switch and `provider.require_parameters`, which
+ * keeps a strict json_schema call off providers that silently drop it.
+ * A field the call sets itself wins. Unset means a byte-identical request.
+ */
+export function chatExtraBody(raw: string | undefined): Record<string, unknown> | undefined {
+  const trimmed = raw?.trim();
+  if (!trimmed) return undefined;
+  const parsed: unknown = JSON.parse(trimmed);
+  if (!parsed || typeof parsed !== 'object' || Array.isArray(parsed)) {
+    throw new Error('OPENAI_CHAT_EXTRA_BODY must be a JSON object');
+  }
+  return parsed as Record<string, unknown>;
+}
+
+function requestUrl(input: string | URL | Request): string {
+  if (typeof input === 'string') return input;
+  return input instanceof URL ? input.href : input.url;
+}
+
+function withChatExtraBody(extra: Record<string, unknown>) {
+  return (input: string | URL | Request, init?: RequestInit): Promise<Response> => {
+    if (
+      init?.method === 'POST' &&
+      typeof init.body === 'string' &&
+      new URL(requestUrl(input)).pathname.endsWith('/chat/completions')
+    ) {
+      const body = JSON.parse(init.body) as Record<string, unknown>;
+      init = { ...init, body: JSON.stringify({ ...extra, ...body }) };
+    }
+    return fetch(input, init);
+  };
+}
+
 function buildClient(config: ConfigService, apiKey: string): OpenAI {
+  const extra = chatExtraBody(config.get<string>('OPENAI_CHAT_EXTRA_BODY'));
   return new OpenAI({
     apiKey,
     baseURL: config.get<string>('OPENAI_BASE_URL', 'https://api.openai.com/v1'),
+    ...(extra ? { fetch: withChatExtraBody(extra) } : {}),
     timeout: parseInt(config.get<string>('OPENAI_TIMEOUT_MS', '30000'), 10),
     maxRetries: parseInt(config.get<string>('OPENAI_MAX_RETRIES', '3'), 10),
   });
