@@ -0,0 +1,82 @@
+import { ConfigService } from '@nestjs/config';
+import { createOpenAiClient } from '../src/ai/openai-client';
+import { validateEnv } from '../src/common/env-validation';
+
+const completion = {
+  id: 'c',
+  object: 'chat.completion',
+  created: 0,
+  model: 'm',
+  choices: [{ index: 0, finish_reason: 'stop', message: { role: 'assistant', content: '{}' } }],
+};
+const embedding = { object: 'list', data: [{ object: 'embedding', index: 0, embedding: [0] }] };
+
+function client(extra?: string) {
+  return createOpenAiClient(
+    new ConfigService({
+      OPENAI_API_KEY: 'router-key',
+      OPENAI_BASE_URL: 'http://router.test/api/v1',
+      OPENAI_MAX_RETRIES: '0',
+      ...(extra === undefined ? {} : { OPENAI_CHAT_EXTRA_BODY: extra }),
+    }),
+  )!;
+}
+
+describe('OPENAI_CHAT_EXTRA_BODY', () => {
+  let fetchSpy: jest.SpyInstance;
+  beforeEach(() => {
+    fetchSpy = jest.spyOn(globalThis, 'fetch').mockImplementation(async (input) => {
+      const url = input instanceof Request ? input.url : String(input);
+      const body = url.endsWith('/embeddings') ? embedding : completion;
+      return new Response(JSON.stringify(body), {
+        headers: { 'content-type': 'application/json' },
+      });
+    });
+  });
+  afterEach(() => fetchSpy.mockRestore());
+
+  const sentBody = (call = 0) =>
+    JSON.parse(String((fetchSpy.mock.calls[call]![1] as RequestInit).body)) as Record<
+      string,
+      unknown
+    >;
+
+  it('merges router controls into chat completions, with call fields winning', async () => {
+    await client(
+      '{"reasoning":{"enabled":false},"provider":{"require_parameters":true},"temperature":1}',
+    ).chat.completions.create({
+      model: 'deepseek/deepseek-v4.1-flash',
+      messages: [{ role: 'user', content: 'rank' }],
+      temperature: 0,
+    });
+    expect(sentBody()).toMatchObject({
+      model: 'deepseek/deepseek-v4.1-flash',
+      reasoning: { enabled: false },
+      provider: { require_parameters: true },
+      temperature: 0,
+    });
+  });
+
+  it('leaves other endpoints and unset configuration unchanged', async () => {
+    await client('{"reasoning":{"enabled":false}}').embeddings.create({
+      model: 'e',
+      input: 'x',
+    });
+    expect(sentBody()).not.toHaveProperty('reasoning');
+    await client().chat.completions.create({ model: 'm', messages: [] });
+    expect(sentBody(1)).not.toHaveProperty('reasoning');
+  });
+
+  it.each(['[]', '"text"', '{broken'])('rejects %s at boot', (raw) => {
+    expect(() =>
+      validateEnv({
+        NODE_ENV: 'test',
+        SURREALDB_URL: 'ws://db:8000',
+        SURREALDB_USERNAME: 'u',
+        SURREALDB_PASSWORD: 'p',
+        OPENAI_API_KEY: 'router-key',
+        OPENAI_CHAT_EXTRA_BODY: raw,
+      }),
+    ).toThrow('OPENAI_CHAT_EXTRA_BODY');
+  });
+});
