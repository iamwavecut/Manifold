--- /dev/null
+++ b/test/document-reindex-boot.unit-spec.ts
@@ -0,0 +1,60 @@
+/**
+ * A boot does not re-read the stored documents on its own. A host that
+ * stores every revision as its own document would have each superseded
+ * revision read again, and its old statements would replace current facts
+ * (seen after the move to v2.11.0, 2026-11-27). The walk stays behind
+ * REINDEX_ON_PACK_INSTALL, the opt-in for a backfill after a pack upgrade.
+ */
+import { DocumentReindexService } from '../src/documents/document-reindex.service';
+
+function boot() {
+  const enqueued: Array<{ dedupKey?: string }> = [];
+  const listeners: Array<(companyId: string) => void> = [];
+  const claim = {
+    enqueue: async (e: { dedupKey?: string }) => {
+      enqueued.push(e);
+      return { runId: 'r', created: true };
+    },
+  };
+  const surreal = {
+    onTenantSchemaReady: (listener: (companyId: string) => void) => {
+      listeners.push(listener);
+    },
+  };
+  new DocumentReindexService(
+    {} as never,
+    {} as never,
+    {} as never,
+    undefined,
+    claim as never,
+    surreal as never,
+  ).onModuleInit();
+  const ready = async () => {
+    for (const listener of listeners) listener('co');
+    await new Promise((r) => setImmediate(r));
+  };
+  return { ready, enqueued };
+}
+
+describe('document reindex on boot', () => {
+  const before = process.env.REINDEX_ON_PACK_INSTALL;
+  afterEach(() => {
+    if (before === undefined) delete process.env.REINDEX_ON_PACK_INSTALL;
+    else process.env.REINDEX_ON_PACK_INSTALL = before;
+  });
+
+  it('enqueues nothing by default', async () => {
+    delete process.env.REINDEX_ON_PACK_INSTALL;
+    const { ready, enqueued } = boot();
+    await ready();
+    expect(enqueued).toEqual([]);
+  });
+
+  it('enqueues the general pass when the backfill is switched on', async () => {
+    process.env.REINDEX_ON_PACK_INSTALL = '1';
+    const { ready, enqueued } = boot();
+    await ready();
+    expect(enqueued).toHaveLength(1);
+    expect(enqueued[0]!.dedupKey).toMatch(/^reindex__general_\d+_start_\d{4}-\d{2}-\d{2}$/);
+  });
+});
