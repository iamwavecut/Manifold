diff --git a/test/surreal-pool-stall.unit-spec.ts b/test/surreal-pool-stall.unit-spec.ts
new file mode 100644
index 00000000..ddeea15c
--- /dev/null
+++ b/test/surreal-pool-stall.unit-spec.ts
@@ -0,0 +1,95 @@
+/**
+ * Manifold 2026-11-21: SurrealDB was OOM-killed while every root-pool
+ * connection carried a query. surrealdb-js reconnected the sockets but never
+ * rejected those queries, so `withCompany` never reached its `finally` and
+ * the leases never came back. Each later acquire timed out for two days
+ * while /health answered ok. `stalledPools` is the signal liveness uses.
+ */
+import { ConfigService } from '@nestjs/config';
+import { SurrealService } from '../src/db/surreal.service';
+
+describe('SurrealService pool stall detection', () => {
+  const STALL_MS = 120_000;
+
+  function setup(poolSize = 2) {
+    const svc = new SurrealService(new ConfigService());
+    const state = svc as any;
+    state.acquireTimeoutMs = 10_000;
+    state.poolStallMs = STALL_MS;
+    state.scopedEnabled = true;
+    const conns = Array.from({ length: poolSize }, (_, i) => ({ id: i }));
+    state.rootIdle.push(...conns);
+    state.scopedIdle.push({ id: 'scoped' });
+    return { svc, state, conns };
+  }
+
+  /** Lease every idle root connection and never release it. */
+  async function leaseAll(state: any, count: number) {
+    for (let i = 0; i < count; i++) await state.acquireRoot();
+  }
+
+  /** One acquire that waits the full timeout and fails. */
+  async function timedOutAcquire(state: any) {
+    const pending = state.acquireRoot().catch((e: Error) => e);
+    await jest.advanceTimersByTimeAsync(10_000);
+    const err = await pending;
+    expect(err).toBeInstanceOf(Error);
+    expect((err as Error).message).toMatch(/root pool acquire timed out/);
+  }
+
+  beforeEach(() => jest.useFakeTimers());
+  afterEach(() => jest.useRealTimers());
+
+  it('reports nothing while acquires succeed', async () => {
+    const { svc, state } = setup();
+    const conn = await state.acquireRoot();
+    state.releaseRoot(conn);
+    await jest.advanceTimersByTimeAsync(STALL_MS * 2);
+    expect(svc.stalledPools()).toEqual([]);
+  });
+
+  it('reports the root pool once its leases have leaked for the stall window', async () => {
+    const { svc, state } = setup();
+    await leaseAll(state, 2);
+    await timedOutAcquire(state);
+    expect(svc.stalledPools()).toEqual([]);
+    await jest.advanceTimersByTimeAsync(STALL_MS - 10_000);
+    await timedOutAcquire(state);
+    expect(svc.stalledPools()).toEqual(['root']);
+  });
+
+  it('clears the stall when a released connection reaches a waiter', async () => {
+    const { svc, state, conns } = setup();
+    await leaseAll(state, 2);
+    await timedOutAcquire(state);
+    await jest.advanceTimersByTimeAsync(STALL_MS);
+    expect(svc.stalledPools()).toEqual(['root']);
+    const waiter = state.acquireRoot();
+    state.releaseRoot(conns[0]);
+    await expect(waiter).resolves.toBe(conns[0]);
+    expect(svc.stalledPools()).toEqual([]);
+  });
+
+  it('does not report a saturated pool that later returns its connections', async () => {
+    const { svc, state, conns } = setup();
+    await leaseAll(state, 2);
+    await timedOutAcquire(state);
+    // The burst ends: both leases come back, nobody acquires for a while.
+    state.releaseRoot(conns[0]);
+    state.releaseRoot(conns[1]);
+    await jest.advanceTimersByTimeAsync(STALL_MS * 2);
+    expect(svc.stalledPools()).toEqual([]);
+  });
+
+  it('tracks the scoped pool separately', async () => {
+    const { svc, state } = setup();
+    await state.acquireWithTimeout(state.scopedIdle, state.scopedWaiters, 'scoped');
+    const pending = state
+      .acquireWithTimeout(state.scopedIdle, state.scopedWaiters, 'scoped')
+      .catch((e: Error) => e);
+    await jest.advanceTimersByTimeAsync(10_000);
+    await pending;
+    await jest.advanceTimersByTimeAsync(STALL_MS);
+    expect(svc.stalledPools()).toEqual(['scoped']);
+  });
+});
