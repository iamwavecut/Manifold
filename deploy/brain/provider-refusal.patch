diff --git a/test/provider-refusal.unit-spec.ts b/test/provider-refusal.unit-spec.ts
new file mode 100644
index 00000000..2bf2c355
--- /dev/null
+++ b/test/provider-refusal.unit-spec.ts
@@ -0,0 +1,154 @@
+/**
+ * A provider that refuses the account (no credit, bad key) must not be asked
+ * again for every failed document, and the refusal must reach the failed run
+ * in a form a caller can classify.
+ */
+import { ExtractorService } from '../src/ai/extractor.service';
+import { ExtractorRunnerService } from '../src/ai/extractor-runner.service';
+import { ExtractorLlmService } from '../src/ai/extractor-llm.service';
+import { ExtractorLocalService } from '../src/ai/extractor-local.service';
+import { ExtractorRefineService } from '../src/ai/extractor-refine.service';
+import { describeRunError, needsOperator, providerRefusal } from '../src/ai/provider-refusal';
+import { ExtractionBatchService } from '../src/documents/extraction-batch.service';
+
+const apiError = (status: number, extra: Record<string, unknown> = {}) =>
+  Object.assign(new Error(`${status} refused: account detail`), { status, ...extra });
+
+describe('providerRefusal', () => {
+  it.each([
+    [apiError(402), 'billing'],
+    [apiError(429, { code: 'insufficient_quota' }), 'billing'],
+    [apiError(429), 'rate_limit'],
+    [apiError(401), 'auth'],
+    [apiError(403), 'auth'],
+    [apiError(503), 'outage'],
+    [apiError(400), undefined],
+    [new Error('incomplete extraction: model response did not finish'), undefined],
+  ])('classifies %s', (err, expected) => {
+    expect(providerRefusal(err)).toBe(expected);
+  });
+
+  it('records a refusal as a marker without the provider message', () => {
+    expect(describeRunError(apiError(402))).toBe(
+      'model provider refused the request (provider_refusal=billing)',
+    );
+    expect(describeRunError(new Error('plain failure'))).toBe('plain failure');
+    expect(needsOperator('billing')).toBe(true);
+    expect(needsOperator('auth')).toBe(true);
+    expect(needsOperator('rate_limit')).toBe(false);
+    expect(needsOperator('outage')).toBe(false);
+  });
+});
+
+function mkExtractor(failure: () => Error): { svc: ExtractorService; calls: () => number } {
+  const config = {
+    get: (k: string, def?: string) =>
+      (
+        ({
+          EXTRACTOR_SC_PASSES: '3',
+          OPENAI_CHAT_MODEL: 'gpt-test',
+          OPENAI_API_KEY: 'sk-test-stub',
+          OPENAI_CONCURRENCY: '8',
+        }) as Record<string, string>
+      )[k] ?? def,
+    getOrThrow: () => 'sk-test-stub',
+  } as never;
+  const registry = { getSnapshot: async () => ({ versionHash: 'h', active: [] }) } as never;
+  const cache = { computeKey: () => 'k', get: () => undefined, set: () => {} } as never;
+  const ner = { isEnabled: () => false, extract: async () => [] } as never;
+  const patterns = { lookup: async () => undefined, record: async () => {} } as never;
+  const llm = new ExtractorLlmService(config);
+  let calls = 0;
+  (llm as unknown as { callLlm: () => Promise<never> }).callLlm = async () => {
+    calls += 1;
+    throw failure();
+  };
+  const local = new ExtractorLocalService(ner, patterns);
+  (local as unknown as { trySkip: () => Promise<null> }).trySkip = async () => null;
+  const refine = new ExtractorRefineService(registry, {
+    selectForExtraction: async () => null,
+  } as never);
+  const runner = new ExtractorRunnerService(llm, local, refine);
+  return { svc: new ExtractorService(cache, registry, runner), calls: () => calls };
+}
+
+describe('extraction when every pass is refused', () => {
+  it('hands the queued reader the refusal with its status', async () => {
+    const h = mkExtractor(() => apiError(402));
+    await expect(h.svc.extractBackground({ text: 'hello', companyId: 'co' })).rejects.toMatchObject(
+      { status: 402 },
+    );
+    expect(h.calls()).toBe(3);
+  });
+
+  it('fails the request path as incomplete and names the refusal', async () => {
+    // A queued retry reads through this path; its run must keep the class.
+    const h = mkExtractor(() => apiError(402));
+    const err = await h.svc.extract('hello', 'co').catch((e: unknown) => e);
+    expect(err).not.toHaveProperty('status');
+    expect(describeRunError(err)).toBe(
+      'incomplete extraction: model provider refused the request (provider_refusal=billing)',
+    );
+  });
+
+  it('still reports other failures as transient', async () => {
+    const h = mkExtractor(() => new Error('model response did not finish'));
+    await expect(h.svc.extractBackground({ text: 'hello', companyId: 'co' })).rejects.toThrow(
+      'transient LLM failure',
+    );
+  });
+});
+
+function batch(failure: () => Error) {
+  const doc = {
+    id: 'source_document:a',
+    occurredAt: new Date(Date.UTC(2026, 8, 26)),
+    chunkCount: 1,
+    meta: {},
+    status: 'indexing',
+  };
+  const enqueued: Array<{ dedupKey: string }> = [];
+  let listed = false;
+  const pass = new ExtractionBatchService(
+    {
+      getById: async () => doc,
+      getChunks: async () => [{ seq: 0, text: 'x', charStart: 0, charEnd: 1 }],
+      setStatus: async () => undefined,
+    } as never,
+    {
+      listAwaitingRuns: async () => {
+        if (listed) return [];
+        listed = true;
+        return [{ docId: doc.id, arrivedAt: new Date(0) }];
+      },
+    } as never,
+    {
+      runGeneral: async () => {
+        throw failure();
+      },
+    } as never,
+    { commitIfRunsSettled: async () => ({ committed: false, deferred: true }) } as never,
+    undefined,
+    {
+      register: () => undefined,
+      enqueue: async (e: { dedupKey: string }) => {
+        enqueued.push(e);
+      },
+    } as never,
+  );
+  return { pass, enqueued };
+}
+
+describe('extraction batch retries', () => {
+  it('schedules no retry pass when the provider refuses the account', async () => {
+    const h = batch(() => apiError(402));
+    expect(await h.pass.runPass('co', { force: true })).toMatchObject({ failed: 1 });
+    expect(h.enqueued).toHaveLength(0);
+  });
+
+  it('keeps the backed-off retry for a transient failure', async () => {
+    const h = batch(() => new Error('extraction produced no usable response'));
+    expect(await h.pass.runPass('co', { force: true })).toMatchObject({ failed: 1 });
+    expect(h.enqueued.map((e) => e.dedupKey)).toEqual([expect.stringMatching(/^xdoc_r1_/)]);
+  });
