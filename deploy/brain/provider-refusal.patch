diff --git a/src/ai/provider-refusal.ts b/src/ai/provider-refusal.ts
new file mode 100644
index 00000000..7d6b7c0f
--- /dev/null
+++ b/src/ai/provider-refusal.ts
@@ -0,0 +1,53 @@
+/**
+ * A refusal about the provider account or the provider itself, not about the
+ * text of one request. Reading the same or another document again cannot
+ * succeed until someone acts (credit, key) or the provider recovers.
+ */
+export type ProviderRefusalClass = 'billing' | 'auth' | 'rate_limit' | 'outage';
+
+const BILLING_MARKERS = new Set(['insufficient_quota', 'credit_balance_exhausted']);
+
+type ProviderErrorFields = {
+  status?: unknown;
+  code?: unknown;
+  type?: unknown;
+  error?: { code?: unknown; type?: unknown };
+};
+
+export function providerRefusal(err: unknown): ProviderRefusalClass | undefined {
+  const e = (err ?? {}) as ProviderErrorFields;
+  if (typeof e.status !== 'number') return undefined;
+  // OpenRouter answers 402 when the account or key cannot pay.
+  if (e.status === 402) return 'billing';
+  if (e.status === 401 || e.status === 403) return 'auth';
+  if (e.status === 429) {
+    const marks = [e.code, e.type, e.error?.code, e.error?.type];
+    return marks.some((m) => typeof m === 'string' && BILLING_MARKERS.has(m))
+      ? 'billing'
+      : 'rate_limit';
+  }
+  return e.status >= 500 ? 'outage' : undefined;
+}
+
+/** Retrying sooner cannot help: an operator has to add credit or fix the key. */
+export function needsOperator(refusal: ProviderRefusalClass | undefined): boolean {
+  return refusal === 'billing' || refusal === 'auth';
+}
+
+/**
+ * The error text a failed indexer run records. A refusal becomes a fixed
+ * marker callers can classify, without the provider's own message.
+ */
+export function describeRunError(err: unknown): string {
+  const refusal = providerRefusal(err);
+  if (!refusal) return (err as Error).message;
+  return `model provider refused the request (provider_refusal=${refusal})`;
+}
+
+/** The class a recorded run error carries, when the provider refused it. */
+export function recordedRefusal(error: unknown): ProviderRefusalClass | undefined {
+  const message = (error as { message?: unknown } | null | undefined)?.message;
+  if (typeof message !== 'string') return undefined;
+  const found = /provider_refusal=(billing|auth|rate_limit|outage)\b/.exec(message);
+  return found?.[1] as ProviderRefusalClass | undefined;
+}
