+  /**
+   * Re-authenticate every acquired scoped connection before it is used.
+   * SurrealDB can restore a websocket without restoring its IAM session;
+   * in that state the socket looks healthy but every scoped query fails as
+   * anonymous. Rebuild the connection when a bounded signin cannot recover it.
+   */
+  private async ensureScopedSession(conn: Surreal): Promise<Surreal> {
+    if (!this.scopedCreds) return conn;
+    try {
+      await withTimeout(conn.signin(this.scopedCreds), 3000, 'scoped signin');
+      return conn;
+    } catch (e) {
+      this.logger.warn(
+        `Scoped signin failed (${(e as Error).message?.slice(0, 120)}) — rebuilding conn`,
+      );
+      try {
+        await withTimeout(conn.close(), 1000, 'scoped close').catch(
+          () => undefined,
+        );
+      } catch {
+        // Closing a dead connection can throw — ignored intentionally.
+      }
+      const fresh = new Surreal();
+      await withTimeout(
+        fresh.connect(this.surrealUrl),
+        5000,
+        'scoped connect',
+      );
+      await withTimeout(
+        fresh.signin(this.scopedCreds),
+        3000,
+        'scoped signin',
+      );
+      const oldIdx = this.all.indexOf(conn);
+      if (oldIdx >= 0) this.all[oldIdx] = fresh;
+      return fresh;
+    }
+  }
