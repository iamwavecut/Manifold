@@ -0,0 +1,35 @@
+/**
+ * The search route's per-credential limit. Upstream hardcodes 10 searches a
+ * minute; a deployment whose one credential serves every agent (Manifold)
+ * raises it with THROTTLE_SEARCH_LIMIT, which the guard resolves on every
+ * request.
+ */
+import { THROTTLER_LIMIT } from '@nestjs/throttler/dist/throttler.constants';
+import { SearchController } from '../src/search/search.controller';
+
+function searchLimit(): number {
+  const limit = Reflect.getMetadata(
+    `${THROTTLER_LIMIT}expensive`,
+    SearchController.prototype.run,
+  ) as () => number;
+  return limit();
+}
+
+describe('search throttle limit', () => {
+  afterEach(() => {
+    delete process.env.THROTTLE_SEARCH_LIMIT;
+  });
+
+  it('keeps the upstream 10 when unset or not a positive integer', () => {
+    expect(searchLimit()).toBe(10);
+    for (const value of ['', '0', '-5', 'many']) {
+      process.env.THROTTLE_SEARCH_LIMIT = value;
+      expect(searchLimit()).toBe(10);
+    }
+  });
+
+  it('reads THROTTLE_SEARCH_LIMIT when a request is checked', () => {
+    process.env.THROTTLE_SEARCH_LIMIT = '600';
+    expect(searchLimit()).toBe(600);
+  });
+});
