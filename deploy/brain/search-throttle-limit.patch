+++ b/src/common/search-throttle-limit.ts
@@ -0,0 +1,9 @@
+/**
+ * Searches per credential and minute. A deployment whose one credential
+ * serves every agent raises it with THROTTLE_SEARCH_LIMIT; anything but a
+ * positive integer keeps the upstream 10.
+ */
+export function searchThrottleLimit(): number {
+  const raw = Number.parseInt(process.env.THROTTLE_SEARCH_LIMIT ?? '', 10);
+  return Number.isInteger(raw) && raw > 0 ? raw : 10;
+}
