diff --git a/test/settle-fact-plan.unit-spec.ts b/test/settle-fact-plan.unit-spec.ts
new file mode 100644
index 00000000..6bad6918
--- /dev/null
+++ b/test/settle-fact-plan.unit-spec.ts
@@ -0,0 +1,54 @@
+/**
+ * Plan guards for fn::settle_fact. Inside a function body SurrealDB 3.3
+ * plans `entityId = $entity_id` as a whole-table scan unless the index is
+ * named, and `UPDATE knowledge_fact ... WHERE id IN $list` reads every row.
+ * 9001 is upstream's newest body with only those statements changed.
+ */
+import { readFileSync, readdirSync } from 'node:fs';
+import { join } from 'node:path';
+
+const DIR = join(__dirname, '../src/db/migrations');
+const read = (name: string) => readFileSync(join(DIR, name), 'utf8');
+const block = (sql: string) => {
+  const start = sql.indexOf('DEFINE FUNCTION OVERWRITE fn::settle_fact(');
+  return sql.slice(start, sql.indexOf('\n};', start) + 3);
+};
+
+describe('fn::settle_fact plan', () => {
+  it('starts from the newest upstream definition', () => {
+    const defining = readdirSync(DIR)
+      .filter((f) => /^\d{4}_.+\.surql$/.test(f) && f < '9000')
+      .filter((f) => /DEFINE FUNCTION[^(]*fn::settle_fact\(/.test(read(f)))
+      .sort();
+    expect(defining.at(-1)).toBe('0177_resolve_fact_without_weights.surql');
+  });
+
+  it('reads the candidate facts through fact_entity_idx', () => {
+    expect(read('9001_settle_fact_entity_index.surql')).toContain(
+      'FROM knowledge_fact WITH INDEX fact_entity_idx',
+    );
+  });
+
+  it('updates competing rows by record, not by a table-wide WHERE', () => {
+    const migration = read('9001_settle_fact_entity_index.surql');
+    expect(migration).not.toContain('WHERE id IN $day_peers.id');
+    expect(migration).not.toMatch(/UPDATE knowledge_fact SET [^;]*WHERE id IN/);
+  });
+
+  it('is the upstream body with only those three statements changed', () => {
+    const expected = block(read('0177_resolve_fact_without_weights.surql'))
+      .replace(
+        '    FROM knowledge_fact\n    WHERE entityId = $entity_id',
+        '    FROM knowledge_fact WITH INDEX fact_entity_idx\n    WHERE entityId = $entity_id',
+      )
+      .replace(
+        "UPDATE knowledge_fact SET status = 'competing' WHERE id IN $day_peers.id;",
+        "UPDATE $day_peers.id SET status = 'competing';",
+      )
+      .replace(
+        "UPDATE knowledge_fact SET status = 'competing' WHERE id IN $day_peers.id OR id = $new.id;",
+        "UPDATE array::append($day_peers.id, $new.id) SET status = 'competing';",
+      );
+    expect(block(read('9001_settle_fact_entity_index.surql'))).toBe(expected);
+  });
+});
