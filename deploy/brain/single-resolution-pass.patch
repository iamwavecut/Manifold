@@ -0,0 +1,59 @@
+/**
+ * Every commit asks for a fact resolution pass. Passes that overlap read
+ * the same oldest facts, each holding about 1 GiB in SurrealDB, so a tenant
+ * runs one at a time; a request made during a pass is served by one more.
+ */
+import { FactResolutionService } from '../src/dreams/fact-resolution.service';
+
+function makeService() {
+  const state = { running: 0, peak: 0, passes: 0 };
+  const surreal = {
+    withCompany: async () => {
+      state.running += 1;
+      state.passes += 1;
+      state.peak = Math.max(state.peak, state.running);
+      await new Promise((r) => setTimeout(r, 5));
+      state.running -= 1;
+      return [];
+    },
+  };
+  const config = { get: (k: string, d?: string) => (k === 'OPENAI_API_KEY' ? 'sk-test' : d) };
+  const service = new FactResolutionService(
+    surreal as never,
+    {} as never,
+    {} as never,
+    config as never,
+  );
+  return { service, state };
+}
+
+describe('fact resolution passes', () => {
+  it('never overlaps for a tenant and serves later requests with one more pass', async () => {
+    const { service, state } = makeService();
+    await Promise.all([1, 2, 3, 4].map(() => service.runPending('co')));
+    expect(state.peak).toBe(1);
+    expect(state.passes).toBe(2);
+  });
+
+  it('starts again after the previous pass ended, and keeps tenants apart', async () => {
+    const { service, state } = makeService();
+    await service.runPending('co');
+    await service.runPending('co');
+    expect(state.passes).toBe(2);
+    await Promise.all([service.runPending('co'), service.runPending('other')]);
+    expect(state.peak).toBe(2);
+    expect(state.passes).toBe(4);
+  });
+
+  it('a failed pass does not block the next one', async () => {
+    const { service, state } = makeService();
+    const surreal = (service as unknown as { surreal: { withCompany: () => Promise<unknown> } })
+      .surreal;
+    const ok = surreal.withCompany;
+    surreal.withCompany = async () => Promise.reject(new Error('connection closed'));
+    await expect(service.runPending('co')).rejects.toThrow('connection closed');
+    surreal.withCompany = ok;
+    await service.runPending('co');
+    expect(state.passes).toBe(1);
+  });
+});
