+describe('WorkerLoopService startup lifecycle', () => {
+  it('starts a handler registered by slow module initialization exactly once', async () => {
+    const priorEnabled = process.env.WORKER_LOOP_ENABLED;
+    const priorRenewInterval = process.env.WORKER_LOOP_LEASE_RENEW_MS;
+    process.env.WORKER_LOOP_ENABLED = '1';
+    process.env.WORKER_LOOP_LEASE_RENEW_MS = '30000';
+    jest.useFakeTimers();
+
+    const runLoop = jest.fn();
+    const poller = {
+      hasClaim: true,
+      startDecay: jest.fn(),
+      stopDecay: jest.fn(),
+      runLoop,
+    };
+    const lease = {
+      tryAcquire: jest.fn(async () => true),
+      release: jest.fn(async () => undefined),
+    };
+    const svc = new WorkerLoopService(poller as never, lease as never);
+    const lifecycle = svc as unknown as {
+      onModuleInit?: () => Promise<void>;
+      onApplicationBootstrap?: () => Promise<void>;
+    };
+
+    try {
+      await lifecycle.onModuleInit?.();
+      // Model another provider still initializing after WorkerLoop's hook.
+      await jest.advanceTimersByTimeAsync(5_000);
+      svc.register('index_document', async () => ({}));
+      await lifecycle.onApplicationBootstrap?.();
+      await jest.advanceTimersByTimeAsync(5_000);
+      await jest.advanceTimersByTimeAsync(30_000);
+
+      expect(runLoop).toHaveBeenCalledTimes(1);
+      expect(runLoop.mock.calls[0]?.[0].jobType).toBe('index_document');
+    } finally {
+      await svc.beforeApplicationShutdown();
+      jest.useRealTimers();
+      if (priorEnabled === undefined) delete process.env.WORKER_LOOP_ENABLED;
+      else process.env.WORKER_LOOP_ENABLED = priorEnabled;
+      if (priorRenewInterval === undefined) delete process.env.WORKER_LOOP_LEASE_RENEW_MS;
+      else process.env.WORKER_LOOP_LEASE_RENEW_MS = priorRenewInterval;
+    }
+  });
+});
